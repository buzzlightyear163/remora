{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/hyperliquid/leaderboard.ts": { "maxDuration": 60 },
    "api/hyperliquid/positions.ts": { "maxDuration": 20 },
    "api/hyperliquid/icon.ts": { "maxDuration": 15 }
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
